{
  "Der Spiegel": {
    "domain": "spiegel.de",
    "allow_cookies": 1,
    "block_regex": "\\.spiegel\\.de\\/public\\/shared\\/generated\\/js\\/commons\\..+\\.js",
    "cs_dompurify": 1,
    "upd_version": "4.4.1.1"
  },
  "Groupe Rossel": {
    "domain": "###_fr_be_groupe_rossel",
    "group": [
      "aisnenouvelle.fr",
      "courrier-picard.fr",
      "lardennais.fr",
      "lavoixdunord.fr",
      "lemessager.fr",
      "lesoir.be",
      "lest-eclair.fr",
      "liberation-champagne.fr",
      "lunion.fr",
      "nordlittoral.fr",
      "paris-normandie.fr",
      "sudinfo.be"
    ],
    "allow_cookies": 1,
    "block_regex": "\\.qiota\\.com",
    "cs_dompurify": 1,
    "cs_param": {"paywall_sel": "r-panel.r-panel--paywall, r-panel.r-paywall--header", "article_sel": "article.r-article > r-article--section, div.r-content, div.qiota_reserve"},
    "upd_version": "4.4.1.3"
  },
  "Newsday": {
    "domain": "newsday.com",
    "allow_cookies": 1,
    "block_regex": "\\.newsday\\.com\\/nd-user\\/nd_user_ace\\.bundle\\.js",
    "cs_code": "[{\"cond\":\"html[class]\", \"rm_attrib\":\"class\"}]",
    "upd_version": "4.4.1.5"
  },
  "Spektrum.de": {
    "domain": "spektrum.de",
    "allow_cookies": 1,
    "block_regex": "\\.poool\\.fr",
    "upd_version": "4.4.0.6"
  }
}
